# worker/.env.example — להעתיק ל-worker/.env ולמלא. worker/.env לא נכנס ל-Git
# (מכוסה ב-.gitignore הראשי של הריפו, שם .env* מוגדר גלובלית).

# כתובת ה-edge function automation-worker. פרודקשן:
PIVO_FUNCTION_URL=https://uoweoqtuiettozagwgdw.supabase.co/functions/v1/automation-worker

# הסוד שמאמת מול verify_automation_worker_secret. להשיג פעם אחת עם:
#   node scripts/print-worker-secret.mjs prod
PIVO_WORKER_SECRET=

# ה-uuid של המשתמש (הרו"ח) שהעובד הזה עובד בשבילו — auth.users.id.
# להשיג מ-Supabase Studio → Authentication → Users, או מכל שורת clients קיימת.
PIVO_USER_ID=

# מזהה חופשי לתהליך הזה — לתיעוד/דיבוג בלבד (claimed_by, automation_workers).
PIVO_WORKER_ID=worker-1

# כמה שניות בין סבב תשאול (poll) לתשאול. ברירת מחדל: 5.
# PIVO_POLL_SECONDS=5

# משך החכירה שכל תפיסה/heartbeat מבקשים, בשניות. ברירת מחדל: 60.
# PIVO_LEASE_SECONDS=60

# 211 · הכנת PDF ברקע — Chrome ללא-ראש פותח את דף ההמרה של האתר. ברירת מחדל: האתר החי.
# PIVO_SITE_URL=https://crm.yasharcpa.co.il
# PIVO_PDF=off            # מכבה את הכנת ה-PDF במחשב הזה
# PIVO_PDF_POLL_SECONDS=20
