{
  "name": "accountant-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "staging:check": "node scripts/staging-check.mjs",
    "staging:verify": "node scripts/staging-verify-schema.mjs",
    "staging:test": "node scripts/seed-staging.mjs && node scripts/staging-test-close-rules.mjs && node scripts/seed-staging.mjs && node scripts/staging-test-required-model.mjs && node scripts/seed-staging.mjs && node scripts/staging-test-email-policy.mjs && node scripts/seed-staging.mjs && node scripts/staging-test-lifecycle.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:setup": "node scripts/setup-test-env.mjs",
    "test:status": "node scripts/setup-test-env.mjs --status",
    "test:reset": "node scripts/setup-test-env.mjs --reset-data",
    "verify:close-rules": "node scripts/verify-close-rules.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.45.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
